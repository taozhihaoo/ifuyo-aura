{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ifuyo Aura",
  "version": "0.1.0",
  "identifier": "com.ifuyo.aura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ifuyo Aura",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3M0Y4MUE3OTYxQzU4NTQKUldSVVdCeVdwNEUvdHdKeGR5WG45Q2ZIb1h5Qmhqa3lPNXFSbnROeklYM3Fjb015M09xYjExT1QK",
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "http://127.0.0.1:19988/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": []
  }
}